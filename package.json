{
  "name": "arychi-web-suite",
  "version": "2.0.0",
  "private": true,
  "description": "Arychi Web Suite Workspace",
  "scripts": {
    "start": "node launcher.mjs",
    "dev": "node launcher.mjs",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:go": "node scripts/build.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "test:go": "go test -v ./backend/tests/...",
    "vet:go": "go vet ./...",
    "server": "go run ./backend/cmd/server",
    "quest": "go run ./backend/cmd/quest",
    "stream": "npm --prefix stream run start:node",
    "build:stream": "npm --prefix stream run build",
    "bot": "go run ./backend/cmd/bot",
    "spoofer": "go run ./backend/cmd/spoofer"
  }
}
