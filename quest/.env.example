# =================================================================
#             ARYCHI QUEST ENGINE & SUBSCRIPTION CONFIG (.env)
# =================================================================
# Cổng chạy Backend Quest Engine & Database Subscription
PORT=3001

# Discord Webhook URL để nhận thông báo hoàn thành nhiệm vụ
WEBHOOK_URL=

# API Key giải Captcha tự động nếu Discord yêu cầu (YesCaptcha)
YES_CAPTCHA_API_KEY = ""

# -----------------------------------------------------------------
# 1. CẤU HÌNH TỰ ĐỘNG XÁC NHẬN THANH TOÁN VIETQR (Gói 50k/tháng)
# -----------------------------------------------------------------
# Mã ngân hàng theo chuẩn VietQR (ví dụ: MB, VCB, TCB, VPB, ICB, ACB...)
VIETQR_BANK_ID = "MB"
VIETQR_BANK_NAME = "MBBank (Ngân hàng Quân Đội)"
VIETQR_ACCOUNT_NO = "0388889999"
VIETQR_ACCOUNT_NAME = "ARYCHI SUITE SYSTEM"
VIETQR_TEMPLATE = "compact2"

# -----------------------------------------------------------------
# 2. CẤU HÌNH CỔNG THANH TOÁN PAYOS (Tùy chọn - nếu dùng PayOS API)
# Lấy tại: https://payos.vn/dashboard
# -----------------------------------------------------------------
PAYOS_CLIENT_ID = ""
PAYOS_API_KEY = ""
PAYOS_CHECKSUM_KEY = ""

# -----------------------------------------------------------------
# 3. CẤU HÌNH ĐĂNG NHẬP OAUTH2 BOT DISCORD (arychi.xyz)
# Lấy tại: https://discord.com/developers/applications
# -----------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URIS=https://arychi.xyz,http://localhost:5173
