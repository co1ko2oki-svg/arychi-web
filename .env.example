# ==============================================================================
#                       ARYCHI SUITE v2.0 - MASTER CONFIG
# ==============================================================================
# Hệ thống hỗ trợ 2 cách cấu hình:
# 1. Cấu hình trực tiếp trên Web UI tại https://dash.arychi.xyz (Khuyến nghị).
# 2. Cấu hình bằng file .env:
#    - Thư mục quest/.env  : Dành cho Quest Engine, VietQR, PayOS, OAuth2
#    - Thư mục stream/.env : Dành cho StreamBot Voice, 2 Token Chính & Phụ, Voice Channel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH THANH TOÁN TỰ ĐỘNG VIETQR (Gói 20.000đ / 1 tháng Full tính năng)
# ------------------------------------------------------------------------------
VIETQR_BANK_ID = "MB"                           # Mã ngân hàng (MB, VCB, TCB, VPB, ICB, ACB...)
VIETQR_BANK_NAME = "MBBank (Ngân hàng Quân Đội)" # Tên ngân hàng hiển thị
VIETQR_ACCOUNT_NO = "0388889999"                 # Số tài khoản ngân hàng nhận tiền
VIETQR_ACCOUNT_NAME = "ARYCHI SUITE SYSTEM"      # Tên chủ tài khoản
VIETQR_TEMPLATE = "compact2"                     # Template mã QR VietQR

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH CỔNG THANH TOÁN PAYOS (Tùy chọn - Tự động xác nhận qua PayOS Webhook)
# Lấy các thông số tại: https://payos.vn/dashboard
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID = ""
PAYOS_API_KEY = ""
PAYOS_CHECKSUM_KEY = ""

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH ĐĂNG NHẬP OAUTH2 BOT DISCORD (Cho tên miền arychi.xyz)
# Lấy tại: https://discord.com/developers/applications -> OAuth2
# ------------------------------------------------------------------------------
DISCORD_CLIENT_ID = ""
DISCORD_CLIENT_SECRET = ""
DISCORD_REDIRECT_URI = "https://arychi.xyz"

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH ĐĂNG KÝ / ĐĂNG NHẬP GOOGLE OAUTH2 (Cho tên miền arychi.xyz)
# Lấy tại: https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID = ""
GOOGLE_REDIRECT_URI = "https://arychi.xyz"

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH TREO STREAM VOICE (Bắt buộc 2 Token: 1 Chính + 1 Phụ)
# (Có thể nhập trực tiếp ở giao diện cột trái của dash.arychi.xyz)
# ------------------------------------------------------------------------------
TOKEN = ""                        # Token Discord Chính (Tài khoản phát video vào kênh thoại)
VIEWER_TOKEN = ""                 # Token Discord Phụ (Tài khoản phụ tự động xem stream để cày giờ)
GUILD_ID = ""                     # Server / Guild ID Discord
VIDEO_CHANNEL_ID = ""             # Voice Channel ID nơi phát video
COMMAND_CHANNEL_ID = ""           # Text Channel ID nơi bot nhận lệnh Discord (tùy chọn)
PREFIX = "$"                      # Prefix lệnh trong Discord
VIEWER_AUTO_WATCH = "true"        # Tự động xem stream tích lũy thời gian
STREAM_LOOP = "true"              # Tự động phát lặp lại video 24/7

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH DISCORD QUEST ENGINE & GIẢI CAPTCHA
# ------------------------------------------------------------------------------
PORT = 3001                       # Port backend Quest Engine (:3001)
SERVER_PORT = 3000                # Port backend StreamBot (:3000)
WEBHOOK_URL = ""                  # Webhook thông báo khi hoàn thành Quest
YES_CAPTCHA_API_KEY = ""          # API key giải captcha tự động (nếu có)
