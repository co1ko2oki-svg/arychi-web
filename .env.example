# ==============================================================================
#                       ARYCHI SUITE v2.0 - MASTER CONFIG
#                      (FILE .ENV DUY NHẤT TOÀN BỘ HỆ THỐNG)
# ==============================================================================
# Không cần dấu ngoặc kép "" khi điền thông tin (chuẩn KEY=VALUE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CỔNG MẠNG VÀ DỊCH VỤ (PORTS)
# ------------------------------------------------------------------------------
PORT=3001
SERVER_PORT=3000

# ------------------------------------------------------------------------------
# 1.1 CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL / MARIADB
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=arychi_db

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH THANH TOÁN TỰ ĐỘNG VIETQR (Gói duy nhất: 20.000đ / 1 tháng Full)
# ------------------------------------------------------------------------------
VIETQR_BANK_ID=MB
VIETQR_BANK_NAME=MBBank (Ngân hàng Quân Đội)
VIETQR_ACCOUNT_NO=0388889999
VIETQR_ACCOUNT_NAME=ARYCHI SUITE SYSTEM
VIETQR_TEMPLATE=compact2

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH CỔNG THANH TOÁN PAYOS (Tùy chọn Webhook)
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH BOT DISCORD DEVELOPER & OAUTH2 (Astral Bot)
# Lấy tại: https://discord.com/developers/applications -> Chọn Bot -> Bot / OAuth2
# ------------------------------------------------------------------------------
# 4.1 Token của Bot Discord (Vào tab 'Bot' -> Bấm 'Reset Token' / 'Copy Token'):
DISCORD_BOT_TOKEN=

# 4.2 Client ID & Secret của Bot (Tab 'OAuth2' -> General):
DISCORD_CLIENT_ID=1555259942192283678
DISCORD_CLIENT_SECRET=
# Danh sách redirect hợp lệ (cách nhau dấu phẩy), phải khớp 100% với mục OAuth2 > Redirects trên Discord Developer Portal
DISCORD_REDIRECT_URIS=https://arychi.xyz,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH THƯ VIỆN & THÔNG SỐ STREAM CỦA SERVER
# (LƯU Ý: TOKEN, VIEWER_TOKEN, PREFIX, GUILD_ID, COMMAND_CHANNEL_ID, VIDEO_CHANNEL_ID,
# ADMIN_IDS được người dùng tự cấu hình trên Web Dashboard và lưu trong MySQL Database)
# ------------------------------------------------------------------------------
VIDEOS_DIR=./videos
PREVIEW_CACHE_DIR=./tmp/preview-cache
YTDLP_COOKIES_PATH=

STREAM_RESPECT_VIDEO_PARAMS=false
STREAM_BITRATE_OVERRIDE=false
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_MAX_WIDTH=0
STREAM_MAX_HEIGHT=0
STREAM_FPS=30
STREAM_BITRATE_KBPS=2000
STREAM_MAX_BITRATE_KBPS=2500
STREAM_HARDWARE_ACCELERATION=false
STREAM_VIDEO_CODEC=H264
STREAM_H26X_PRESET=ultrafast

VIEWER_AUTO_WATCH=true
STREAM_LOOP=true

SERVER_ENABLED=true
SERVER_USERNAME=admin
SERVER_PASSWORD=admin

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH DISCORD QUEST ENGINE & CAPTCHA
# ------------------------------------------------------------------------------
WEBHOOK_URL=
YES_CAPTCHA_API_KEY=
