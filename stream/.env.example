# =================================================================
#             ARYCHI STREAMBOT VOICE & VIEWER FARM CONFIG (.env)
# =================================================================

# 1. CẤU HÌNH TÀI KHOẢN BOT CHÍNH (STREAMER - PHÁT VIDEO KÊNH THOẠI)
TOKEN = ""                        # Token Discord của tài khoản chính phát video
PREFIX = "$"                      # Prefix lệnh trong Discord chat (nếu dùng)
GUILD_ID = ""                     # Server / Guild ID Discord
COMMAND_CHANNEL_ID = ""           # Text channel ID bot phản hồi lệnh
VIDEO_CHANNEL_ID = ""             # Voice channel ID bot sẽ tham gia và phát stream
ADMIN_IDS = []                    # Mảng Discord user ID admin, ví dụ: ["123456789"]

# 2. CẤU HÌNH VIEWER FARM (TOKEN PHỤ - XEM STREAM ĐỂ CÀY GIỜ)
# Bắt buộc để Discord tính giờ stream và mở khóa mốc giờ/badge
VIEWER_TOKEN = ""                 # Token tài khoản Discord phụ tự động vào xem stream
VIEWER_AUTO_WATCH = "true"        # Tự động join và xem stream khi bot chính phát
STREAM_LOOP = "true"              # Tự động phát lặp lại video liên tục 24/7

# 3. THƯ MỤC LƯU TRỮ MEDIA & CACHE
VIDEOS_DIR = "./videos"
PREVIEW_CACHE_DIR = "./tmp/preview-cache"

# 4. TÙY CHỌN YT-DLP (TẢI YOUTUBE / TWITCH)
YTDLP_COOKIES_PATH = ""           # Đường dẫn file cookies.txt nếu tải video giới hạn độ tuổi

# 5. THÔNG SỐ CHẤT LƯỢNG LUỒNG STREAM DISCORD
STREAM_RESPECT_VIDEO_PARAMS = "false"
STREAM_BITRATE_OVERRIDE = "false"
STREAM_WIDTH = "1280"
STREAM_HEIGHT = "720"
STREAM_MAX_WIDTH = "0"
STREAM_MAX_HEIGHT = "0"
STREAM_FPS = "30"
STREAM_BITRATE_KBPS = "2000"
STREAM_MAX_BITRATE_KBPS = "2500"
STREAM_HARDWARE_ACCELERATION = "false"
STREAM_VIDEO_CODEC = "H264"       # H264, VP8, H265
STREAM_H26X_PRESET = "ultrafast"  # ultrafast, superfast, veryfast, faster, fast, medium

# 6. CỔNG DỊCH VỤ WEB API STREAMBOT
SERVER_ENABLED = "true"
SERVER_USERNAME = "admin"
SERVER_PASSWORD = "admin"
SERVER_PORT = "3000"
