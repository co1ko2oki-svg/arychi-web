# Selfbot options
TOKEN = "" # Your Discord user token (Account token)
PREFIX = "$" # The prefix used to trigger commands
GUILD_ID = "" # Server/Guild ID
COMMAND_CHANNEL_ID = "" # Text channel ID where bot listens to commands
VIDEO_CHANNEL_ID = "" # Voice channel ID where bot will stream video
ADMIN_IDS = [] # Array of user IDs with admin permissions, e.g. ["123456789"]

# General options
VIDEOS_DIR = "./videos"
PREVIEW_CACHE_DIR = "./tmp/preview-cache"

# yt-dlp options
YTDLP_COOKIES_PATH = "" # Optional path to cookies.txt

# Stream options
STREAM_RESPECT_VIDEO_PARAMS = "false"
STREAM_BITRATE_OVERRIDE = "false"
STREAM_WIDTH = "1280"
STREAM_HEIGHT = "720"
STREAM_MAX_WIDTH = "0"
STREAM_MAX_HEIGHT = "0"
STREAM_FPS = "30"
STREAM_BITRATE_KBPS = "2000"
STREAM_MAX_BITRATE_KBPS = "2500"
STREAM_HARDWARE_ACCELERATION = "false"
STREAM_VIDEO_CODEC = "H264"
STREAM_H26X_PRESET = "ultrafast"

# Stream Farm & Viewer options (Treo farm giờ stream / badge)
VIEWER_TOKEN = "" # Token tài khoản phụ để xem stream (bắt buộc để Discord tính giờ stream/badge)
VIEWER_AUTO_WATCH = "true" # Tự động join và xem stream khi bot chính phát
STREAM_LOOP = "true" # Tự động phát lặp lại video liên tục không tắt để treo farm 24/7

