# =================================================================
#             ARYCHI STREAMBOT VOICE & VIEWER FARM CONFIG (.env)
# =================================================================
# LƯU Ý: TOKEN, VIEWER_TOKEN, PREFIX, GUILD_ID, COMMAND_CHANNEL_ID,
# VIDEO_CHANNEL_ID, ADMIN_IDS được người dùng tự cấu hình trực tiếp
# trên giao diện Web Dashboard (dash.arychi.xyz) và lưu trong MySQL Database.
# =================================================================

# 1. THƯ MỤC LƯU TRỮ MEDIA & CACHE
VIDEOS_DIR=./videos
PREVIEW_CACHE_DIR=./tmp/preview-cache

# 2. TÙY CHỌN YT-DLP (TẢI YOUTUBE / TWITCH)
YTDLP_COOKIES_PATH=

# 3. THÔNG SỐ CHẤT LƯỢNG LUỒNG STREAM DISCORD
STREAM_RESPECT_VIDEO_PARAMS=false
STREAM_BITRATE_OVERRIDE=false
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_MAX_WIDTH=0
STREAM_MAX_HEIGHT=0
STREAM_FPS=30
STREAM_BITRATE_KBPS=2000
STREAM_MAX_BITRATE_KBPS=2500
STREAM_HARDWARE_ACCELERATION=false
STREAM_VIDEO_CODEC=H264
STREAM_H26X_PRESET=ultrafast

VIEWER_AUTO_WATCH=true
STREAM_LOOP=true

# 4. CỔNG DỊCH VỤ WEB API STREAMBOT
SERVER_ENABLED=true
SERVER_USERNAME=admin
SERVER_PASSWORD=admin
SERVER_PORT=3000
